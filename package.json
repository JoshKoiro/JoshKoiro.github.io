{
  "name": "joshkoiro.github.io",
  "private": true,
  "type": "module",
  "description": "Personal site: joshkoiro.github.io",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "npm install && bundle install",
    "serve": "bundle exec jekyll serve --livereload",
    "build": "bundle exec jekyll build",
    "clean": "bundle exec jekyll clean",
    "check": "node scripts/check.mjs && npm run build",
    "deploy": "npm run check && git push"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  }
}
